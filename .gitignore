# Cargo build artifacts (root or per-case under repros/<case-slug>/)
/debug/
**/target/

# Cargo.lock is intentionally NOT ignored: executable cases under repros/
# must commit their lockfiles for reproducible dependency resolution.

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows debugging symbols
*.pdb

# Cargo mutants output
**/mutants.out*/

# rustc internal compiler error dumps
rustc-ice-*.txt

# Local raw profiling and OS artifacts
perf.data
perf.data.old
*.profraw
*.profdata
*.dSYM/
.DS_Store
